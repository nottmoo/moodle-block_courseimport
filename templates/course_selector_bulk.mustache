{{!
    @template block_courseimport/course_selector_bulk

    Course search UI (same structure as course_search, refreshed wrapper for tabs).
}}
<div class="import-course-search import-course-search-bulk card card-body mb-3">
    <div>{{#str}} totalcoursesearchresults, core_backup, {{resultcount}} {{/str}}</div>
    <div class="ics-results">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>{{#str}} fullnamecourse {{/str}}</th>
                    <th>{{#str}} shortnamecourse {{/str}}</th>
                    <th>{{#str}} courseid, block_courseimport {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#nomatching}}<tr>
                    <td colspan="4"><div class="alert alert-danger">{{#str}} nomatchingcourses, core_backup {{/str}}</div></td>
                </tr>{{/nomatching}}
                {{#courses}}<tr class="ics-course{{^visible}} dimmed{{/visible}}{{#highlight}} bold{{/highlight}}">
                    <td><input type="radio" id="importid-{{id}}" name="importid" value="{{id}}" {{#highlight}}checked="checked"{{/highlight}}/></td>
                    <td><label for="importid-{{id}}">{{fullname}}</label></td>
                    <td>{{shortname}}</td>
                    <td>{{id}}</td>
                </tr>{{/courses}}
                {{#hasinaccesibile}}<tr>
                    <td colspan="4"><div class="alert alert-danger">{{#str}} askroleinfo, block_courseimport {{/str}}</div></td>
                </tr>{{/hasinaccesibile}}
                {{#othercourses}}<tr class="ics-course{{^visible}} dimmed{{/visible}}">
                    <td></td>
                    <td>{{fullname}}</td>
                    <td>{{shortname}}</td>
                    <td>{{id}}</td>
                </tr>{{/othercourses}}
            </tbody>
        </table>
    </div>
    <div class="ics-search input-group">
        <label for="searchcoursesinput" class="sr-only">{{#str}} searchcourses, block_courseimport {{/str}}</label>
        <input
            type="text"
            id="searchcoursesinput"
            name="{{searchname}}"
            value="{{searchvalue}}"
            placeholder="{{#str}} searchcourses, block_courseimport {{/str}}"
            autocomplete="off"
            class="form-control"
        />
        <div class="input-group-append">
            <input type="submit" name="searchcourses" value="{{#str}} search {{/str}}" class="btn btn-secondary" />
        </div>
    </div>
</div>
