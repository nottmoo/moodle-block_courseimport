{{!
    @template block_courseimport/course_search

    The course search interface.

    Lists courses that the user can import content from using the block.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * courses
        - fullname
        - highlight
        - id
        - shortname
        - visibile
    * hasinaccesibile
    * nomatching
    * othercourses
        - fullname
        - id
        - shortname
        - visibile
    * resultcount
    * searchname
    * searchvalue

    Example context (json):
    {
        "courses": [
            {
                "fullname": "Course name",
                "highlight": true,
                "id": 32,
                "shortname": "CRSE",
                "visible": true
            },
            {
                "fullname": "Course 3",
                "highlight": false,
                "id": 56,
                "shortname": "CRSE3",
                "visible": false
            }
        ],
        "hasinaccesibile": true,
        "nomatching": true,
        "othercourses": [
            {
                "fullname": "Course 2",
                "id": 42,
                "shortname": "CRSE2",
                "visible": true
            }
        ],
        "resultcount": 3,
        "searchname": "search",
        "searchvalue": ""
    }
}}
<div class="import-course-search">
    <div>{{#str}} totalcoursesearchresults, core_backup, {{resultcount}} {{/str}}</div>
    <div class="ics-results">
        <table class="table table-striped">
            <thead>
                <tr>
                    <th></th>
                    <th>{{#str}} shortnamecourse {{/str}}</th>
                    <th>{{#str}} fullnamecourse {{/str}}</th>
                    <th>{{#str}} courseid, block_courseimport {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#nomatching}}<tr>
                    <td colspan="4"><div class="alert alert-danger">{{#str}} nomatchingcourses, core_backup {{/str}}</div></td>
                </tr>{{/nomatching}}
                {{#courses}}<tr class="ics-course{{^visible}} dimmed{{/visible}}{{#highlight}} bold{{/highlight}}">
                    <td><input type="radio" id="importid-{{id}}" name="importid" value="{{id}}" {{#highlight}}checked="checked"{{/highlight}}/></td>
                    <td>{{shortname}}</td>
                    <td>{{fullname}}</td>
                    <td>{{id}}</td>
                </tr>{{/courses}}
                {{#hasinaccesibile}}<tr>
                    <td colspan="4"><div class="alert alert-danger">{{#str}} askroleinfo, block_courseimport {{/str}}</div></td>
                </tr>{{/hasinaccesibile}}
                {{#othercourses}}<tr class="ics-course{{^visible}} dimmed{{/visible}}">
                    <td></td>
                    <td>{{shortname}}</td>
                    <td>{{fullname}}</td>
                    <td>{{id}}</td>
                </tr>{{/othercourses}}
            </tbody>
        </table>
    </div>
    <div class="ics-search">
        <input type="text" name="{{searchname}}" value="{{searchvalue}}" />
        <input type="submit" name="searchcourses" value="{{#str}} search {{/str}}" />
    </div>
</div>
