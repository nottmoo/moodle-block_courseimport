{{!
    @template block_courseimport/bulk_submit_preview

    Bulk CSV confirmation preview (bulk/submit.php after upload).

    Context variables required for this template:
    * summarytext Localised summary line (rows, resolved, unmatched, to import, skipped).
    * haserrors When true, shows the unmatched rows table (displayed before resolved pairs).
    * errorrows List of error row objects: rowlabel, errortype, optional errorparams, errormessage.
    * errorpaginationtop Raw HTML for pagination above the errors table (may be empty).
    * errorpaginationbottom Raw HTML for pagination below the errors table (may be empty).
    * haspairs When true, shows the resolved pairs table (after errors).
    * pairrows List of resolved pair row objects.
    * pairpaginationtop Raw HTML for pagination above the pairs table (may be empty).
    * pairpaginationbottom Raw HTML for pagination below the pairs table (may be empty).
    * cancelurl URL that clears this pack id then returns to bulk upload.
    * confirmbaseurl Form action URL for confirm submit (when haspairs).
    * packid Confirmation cache pack id (isolates concurrent browser tabs).
    * sesskey Session key for confirm / cancel.

    Example context (json):
    {
        "summarytext": "Rows: 2, resolved: 2, unmatched: 0, to import: 2, skipped: 0",
        "haspairs": true,
        "pairrows": [
            {
                "hassourcecourse": true,
                "sourceshortname": "SRC101",
                "sourcefullname": "Source course",
                "sourceid": 5,
                "targetid": 99,
                "csvshortname": "TGT101",
                "csvfullname": "Target course",
                "actionlabel": "Will import"
            }
        ],
        "pairpaginationtop": "",
        "pairpaginationbottom": "",
        "haserrors": false,
        "errorrows": [],
        "errorpaginationtop": "",
        "errorpaginationbottom": "",
        "cancelurl": "/blocks/courseimport/bulk/submit.php?cancel=1&packid=abc&sesskey=xyz",
        "confirmbaseurl": "/blocks/courseimport/bulk/submit.php",
        "packid": "abc123packid01",
        "sesskey": "abc123"
    }
}}
<div class="block-courseimport-bulk-submit-preview container-fluid">
    <h2 class="mb-3">{{#str}} bulkpreviewheading, block_courseimport {{/str}}</h2>
    <p>{{summarytext}}</p>

    {{#haserrors}}
    <h4 class="mt-4">{{#str}} bulkpreviewerrors, block_courseimport {{/str}}</h4>
    {{{errorpaginationtop}}}
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>{{#str}} bulkpreviewcolrow, block_courseimport {{/str}}</th>
                    <th>{{#str}} error {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#errorrows}}
                <tr>
                    <td>{{rowlabel}}</td>
                    <td>{{errormessage}}</td>
                </tr>
                {{/errorrows}}
            </tbody>
        </table>
    </div>
    {{{errorpaginationbottom}}}
    {{/haserrors}}
    {{^haserrors}}
    <p class="mt-4">{{#str}} bulkpreviewnoerrors, block_courseimport {{/str}}</p>
    {{/haserrors}}

    {{#haspairs}}
    <h4 class="mt-4">{{#str}} bulkpreviewresolved, block_courseimport {{/str}}</h4>
    {{{pairpaginationtop}}}
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>{{#str}} bulkstatussource, block_courseimport {{/str}}</th>
                    <th>{{#str}} bulkstatustarget, block_courseimport {{/str}}</th>
                    <th>{{#str}} shortname {{/str}}</th>
                    <th>{{#str}} fullname {{/str}}</th>
                    <th>{{#str}} bulkpreviewaction, block_courseimport {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#pairrows}}
                <tr>
                    <td>
                        {{#hassourcecourse}}
                        <span class="font-weight-bold">{{sourceshortname}}</span><br>
                        <small class="text-muted">{{sourcefullname}}</small>
                        {{/hassourcecourse}}
                        {{^hassourcecourse}}
                        <span class="text-muted">#{{sourceid}}</span>
                        {{/hassourcecourse}}
                    </td>
                    <td>
                        <span class="text-muted">#{{targetid}}</span>
                    </td>
                    <td>{{csvshortname}}</td>
                    <td>{{csvfullname}}</td>
                    <td>{{actionlabel}}</td>
                </tr>
                {{/pairrows}}
            </tbody>
        </table>
    </div>
    {{{pairpaginationbottom}}}
    {{/haspairs}}

    <div class="mt-4">
        {{^haspairs}}
        <a class="btn btn-primary" href="{{cancelurl}}">{{#str}} continue {{/str}}</a>
        {{/haspairs}}
        {{#haspairs}}
        <form method="post" action="{{confirmbaseurl}}" class="d-inline">
            <input type="hidden" name="confirm" value="1">
            <input type="hidden" name="packid" value="{{packid}}">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <button type="submit" class="btn btn-primary">{{#str}} bulkconfirmsubmit, block_courseimport {{/str}}</button>
        </form>
        <a class="btn btn-secondary ms-2" href="{{cancelurl}}">{{#str}} cancel {{/str}}</a>
        {{/haspairs}}
    </div>
</div>
