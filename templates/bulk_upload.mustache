{{!
    @template block_courseimport/bulk_upload

    Bulk CSV rollover upload page: main column (heading, optional active-job notice, rendered upload form)
    and optionally a sidebar when the user may change import settings (enabled profile + link).

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * heading Page title (plain text).
    * statusurl URL to bulk results list; if empty/falsy the "view status" link block is hidden.
    * formhtml Raw HTML for the Moodle form (from moodleform::display()).
    * activebulknotice Optional object when the user has a queued bulk job: url (string), jobid (int).
    * enableditems List of objects with key label (string) for the sidebar checklist.
    * showsettings When true, the import profile sidebar is shown; omitted users see no sidebar.
    * settingsurl Block admin settings URL; set only when showsettings is true.

    Example context (json):
    {
        "heading": "Bulk course rollover",
        "statusurl": "/blocks/courseimport/bulk/results.php",
        "formhtml": "<p class=\\"text-muted\\">[Example: CSV upload form would render here]</p>",
        "activebulknotice": {
            "url": "/blocks/courseimport/bulk/results.php?bulkid=12",
            "jobid": 12
        },
        "enableditems": [
            {"label": "Activities"},
            {"label": "Blocks"}
        ],
        "showsettings": true,
        "settingsurl": "/admin/settings.php?section=blocksettingcourseimport"
    }
}}
<div class="block-courseimport-bulk-upload container-fluid">
    <div class="row">
        <div class="{{#showsettings}}col-lg-8 col-md-7{{/showsettings}}{{^showsettings}}col-12{{/showsettings}}">
            <h2 class="mb-2">{{heading}}</h2>
            {{#statusurl}}
            <div class="mb-3">
                <a href="{{statusurl}}">{{#str}} bulkstatusview, block_courseimport {{/str}}</a>
            </div>
            {{/statusurl}}

            {{#activebulknotice}}
            <div class="alert alert-info d-flex align-items-center justify-content-between mt-2 mb-3" role="alert">
                <span>{{#str}} bulkactiveimports, block_courseimport {{/str}} — {{#str}} bulkstatusid, block_courseimport {{/str}} #{{jobid}}</span>
                <a href="{{url}}" class="btn btn-sm btn-outline-primary ms-3">{{#str}} bulkstatusview, block_courseimport {{/str}}</a>
            </div>
            {{/activebulknotice}}

            <div class="card">
                <div class="card-body">
                    {{{formhtml}}}
                </div>
            </div>
        </div>
        {{#showsettings}}
        <div class="col-lg-4 col-md-5 mt-4 mt-md-0">
            <div class="card h-100 border-secondary">
                <div class="card-header">
                    <strong>{{#str}} bulkenabledsettingstitle, block_courseimport {{/str}}</strong>
                </div>
                <div class="card-body">
                    <p class="small text-muted mb-3">{{#str}} bulkenabledsettingsintro, block_courseimport {{/str}}</p>
                    <ul class="mb-4 ps-3">
                        {{#enableditems}}
                        <li>{{label}}</li>
                        {{/enableditems}}
                        {{^enableditems}}
                        <li class="text-muted small">{{#str}} bulkenabledsettingsnone, block_courseimport {{/str}}</li>
                        {{/enableditems}}
                    </ul>
                    <a class="btn btn-outline-secondary btn-sm" href="{{settingsurl}}">{{#str}} courseimportsettings, block_courseimport {{/str}}</a>
                </div>
            </div>
        </div>
        {{/showsettings}}
    </div>
</div>
