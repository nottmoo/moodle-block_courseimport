{{!
    @template block_courseimport/import_page_with_tabs

    Tabs: single course import (in-page) and link to bulk CSV rollover.
}}
<div class="block-courseimport-import-tabs mb-4">
    <ul class="nav nav-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <a class="nav-link active" id="courseimport-tab-single" data-bs-toggle="tab" href="#courseimport-pane-single" role="tab" aria-controls="courseimport-pane-single" aria-selected="true">
                {{singletablabel}}
            </a>
        </li>
        <li class="nav-item" role="presentation">
            <a class="nav-link" id="courseimport-tab-bulk" href="{{bulkurl}}" role="tab">
                {{bulktablabel}}
            </a>
        </li>
    </ul>
    <div class="tab-content border border-top-0 p-3">
        <div class="tab-pane fade show active" id="courseimport-pane-single" role="tabpanel" aria-labelledby="courseimport-tab-single">
            {{{singlecontent}}}
        </div>
    </div>
</div>
