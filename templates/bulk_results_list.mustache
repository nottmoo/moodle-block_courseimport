{{!
    @template block_courseimport/bulk_results_list

    User's bulk rollover jobs: summary table + paging.
}}
<div class="block-courseimport-bulk-results-list">
    <h2>{{heading}}</h2>

    {{#hasjobs}}
        <div class="mb-2 text-muted">{{paginationtext}}</div>
        {{{pagingtop}}}
        <table class="generaltable">
            <thead>
                <tr>
                    {{#tableheaders}}
                        <th>{{.}}</th>
                    {{/tableheaders}}
                </tr>
            </thead>
            <tbody>
                {{#jobrows}}
                    <tr>
                        <td>{{idlabel}}</td>
                        <td>{{total}}</td>
                        <td>{{completed}}</td>
                        <td>{{failed}}</td>
                        <td>{{status}}</td>
                        <td>{{progressdisplay}}</td>
                        <td>{{{viewlink}}}</td>
                    </tr>
                {{/jobrows}}
            </tbody>
        </table>
        {{{pagingbottom}}}
    {{/hasjobs}}
    {{^hasjobs}}
        <div class="alert alert-info">{{emptymessage}}</div>
    {{/hasjobs}}

    <div class="mt-3">
        {{{backlink}}}
    </div>
</div>
