{{!
    @template block_courseimport/bulk_results_list

    Lists the current user's bulk rollover parent jobs (summary table, paging, empty state).

    Classes required for JS:
    * none

    Data attributes required for JS:
    * none

    Context variables required for this template:
    * hasjobs If true, table and paging are shown; if false, the empty state is shown.
    * from First visible row number (1-based) when hasjobs is true.
    * to Last visible row number when hasjobs is true.
    * total Total parent bulk jobs across all pages.
    * pagingtop Raw HTML for paging controls above the table (often empty when not needed).
    * pagingbottom Raw HTML for paging controls below the table (same markup as pagingtop).
    * jobrows List of row objects: idlabel, total, completed, failed, status, progressdisplay, viewlink (raw HTML link).

    Example context (json):
    {
        "hasjobs": true,
        "from": 1,
        "to": 2,
        "total": 2,
        "pagingtop": "",
        "pagingbottom": "",
        "jobrows": [
            {
                "idlabel": "#101",
                "total": 5,
                "completed": 2,
                "failed": 0,
                "status": "queued",
                "progressdisplay": "40%",
                "viewlink": "<a href=\\"#\\">View</a>"
            }
        ]
    }
}}
<div class="block-courseimport-bulk-results-list">
    <h2>{{#str}} bulkstatuslistheading, block_courseimport {{/str}}</h2>

    {{#hasjobs}}
        <div class="mb-2 text-muted">{{#str}}bulkpagination, block_courseimport, {"from": {{from}}, "to": {{to}}, "total": {{total}}}{{/str}}</div>
        {{{pagingtop}}}
        <table class="generaltable">
            <thead>
                <tr>
                    <th>{{#str}} bulkstatuscolumnd, block_courseimport {{/str}}</th>
                    <th>{{#str}} bulkstatustotal, block_courseimport {{/str}}</th>
                    <th>{{#str}} bulkstatuscompleted, block_courseimport {{/str}}</th>
                    <th>{{#str}} bulkstatusfailed, block_courseimport {{/str}}</th>
                    <th>{{#str}} bulkstatusstate, block_courseimport {{/str}}</th>
                    <th>{{#str}} bulkstatusprogress, block_courseimport {{/str}}</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {{#jobrows}}
                    <tr>
                        <td>{{idlabel}}</td>
                        <td>{{total}}</td>
                        <td>{{completed}}</td>
                        <td>{{failed}}</td>
                        <td>{{status}}</td>
                        <td>{{progressdisplay}}</td>
                        <td>{{{viewlink}}}</td>
                    </tr>
                {{/jobrows}}
            </tbody>
        </table>
        {{{pagingbottom}}}
    {{/hasjobs}}
    {{^hasjobs}}
        <div class="alert alert-info">{{#str}} bulkstatusnone, block_courseimport {{/str}}</div>
    {{/hasjobs}}
</div>
