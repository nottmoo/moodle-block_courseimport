{{!
    @template block_courseimport/bulk_status

    Single bulk rollover job on results.php: progress while queued, final summary when finished,
    filter links for child import jobs, and a paginated table of child jobs.

    Classes required for JS:
    * none (AMD uses element ids and data-region hooks; see block_courseimport/bulk_status_progress.)

    Data attributes required for JS:
    * data-region="bulk-progress-bar", data-region="bulk-counts" on descendants of the root id.

    Context variables required for this template:
    * heading Page title (typically includes bulk job id).
    * total Total child units in the bulk job.
    * completed Child jobs completed successfully.
    * failed Child jobs that failed.
    * status Raw status code/string for the parent bulk job.
    * statuslabel Localised label for the parent bulk status (finished jobs).
    * progresstitle Localised card title while the job is running (queued vs processing).
    * progresspct Integer 0-100 for the progress bar width.
    * barlabel Localised progress bar label (for example, "4 of 10").
    * bulkid Parent bulk job id (used for root element id and AMD init).
    * countstext Plain-text line for completed/total/failed counts (matches AJAX poll output).
    * isrunning When true, shows animated progress card and loads {@see block_courseimport/bulk_status_progress} to poll via web service.
    * hasfailed When isrunning is false, selects warning vs success alert styling.
    * showchildjobfilters When true, renders childjobfilteritems navigation.
    * childjobfilteritems List of objects: url, label, count, current (bool).
    * childheading Subheading above the child jobs table.
    * childpaginationtop Raw HTML for pagination above the child table (may be empty).
    * childpaginationbottom Raw HTML for pagination below the child table.
    * childjobs List of row objects: rownum, target, targetid, targetlinkurl (optional URL string),
      source, sourceid, statelabel.

    Example context (json):
    {
        "bulkid": 42,
        "heading": "Bulk job #42",
        "total": 10,
        "completed": 3,
        "failed": 1,
        "countstext": "Completed: 3 / Total: 10 · Failed: 1",
        "status": "partial",
        "progresspct": 40,
        "isrunning": false,
        "hasfailed": true,
        "showchildjobfilters": true,
        "childjobfilteritems": [
            {
                "url": "/blocks/courseimport/bulk/results.php?bulkid=42&completed=0",
                "label": "All imports",
                "count": 10,
                "current": true
            },
            {
                "url": "/blocks/courseimport/bulk/results.php?bulkid=42&completed=1",
                "label": "Completed only",
                "count": 4,
                "current": false
            }
        ],
        "childheading": "Import jobs",
        "childpaginationtop": "",
        "childpaginationbottom": "",
        "childjobs": [
            {
                "rownum": 1,
                "target": "Target course",
                "targetid": 99,
                "targetlinkurl": "/course/view.php?id=99",
                "source": "Source course",
                "sourceid": 88,
                "statelabel": "Finished"
            }
        ]
    }
}}
<div class="block-courseimport-bulk-status container-fluid" id="block-courseimport-bulk-root-{{bulkid}}">
    <h2>{{heading}}</h2>

    {{#isrunning}}
    <div class="card mb-4" data-region="bulk-running-card">
        <div class="card-body">
            <h5 class="card-title mb-3" data-region="bulk-progress-title">{{progresstitle}}</h5>

            <div class="progress mb-2 block-courseimport-progress">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-success block-courseimport-progress-bar"
                     data-region="bulk-progress-bar"
                     role="progressbar"
                     style="width: {{progresspct}}%;"
                     aria-valuenow="{{progresspct}}"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    {{barlabel}}
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted" data-region="bulk-counts">{{countstext}}</small>
                <small class="text-muted" aria-live="polite" data-region="bulk-progress-refreshing">{{#str}} bulkstatusrefreshing, block_courseimport {{/str}}</small>
            </div>
        </div>
    </div>
    {{/isrunning}}

    {{^isrunning}}
    <div class="alert {{#hasfailed}}alert-warning{{/hasfailed}}{{^hasfailed}}alert-success{{/hasfailed}} mb-4" role="alert">
        <strong>{{#str}} bulkstatusstate, block_courseimport {{/str}}:</strong> {{statuslabel}}
        &nbsp;·&nbsp; {{#str}} bulkstatuscompleted, block_courseimport {{/str}}: {{completed}}
        &nbsp;·&nbsp; {{#str}} bulkstatustotal, block_courseimport {{/str}}: {{total}}
        {{#failed}} &nbsp;·&nbsp; {{#str}} bulkstatusfailed, block_courseimport {{/str}}: {{failed}} {{/failed}}
    </div>
    {{/isrunning}}

    {{#showchildjobfilters}}
    <nav class="mb-3 block-courseimport-childjob-filters" aria-label="{{#str}} bulkchildjobfiltersnav, block_courseimport {{/str}}">
        <div class="d-flex flex-wrap align-items-baseline column-gap-3 row-gap-2">
            {{#childjobfilteritems}}
            <span>
                <a href="{{url}}"{{#current}} class="fw-bold text-decoration-underline" aria-current="page"{{/current}}>{{label}}</a> <span class="text-body-secondary" data-region="bulk-filter-count" data-filter="{{filterkey}}">{{count}}</span>
            </span>
            {{/childjobfilteritems}}
        </div>
    </nav>
    {{/showchildjobfilters}}

    <h3>{{childheading}}</h3>
    {{{childpaginationtop}}}
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>{{#str}} bulkstatusjobid, block_courseimport {{/str}}</th>
                    <th>{{#str}} bulkstatustarget, block_courseimport {{/str}}</th>
                    <th>{{#str}} bulkstatussource, block_courseimport {{/str}}</th>
                    <th>{{#str}} bulkstatusjobstate, block_courseimport {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#childjobs}}
                <tr>
                    <td>{{rownum}}</td>
                    <td>
                        {{#targetlinkurl}}
                        <a href="{{targetlinkurl}}" target="_blank" rel="noopener noreferrer">{{target}}</a> ({{targetid}})
                        {{/targetlinkurl}}
                        {{^targetlinkurl}}
                        {{target}} ({{targetid}})
                        {{/targetlinkurl}}
                    </td>
                    <td>{{source}} ({{sourceid}})</td>
                    <td>{{statelabel}}</td>
                </tr>
                {{/childjobs}}
                {{^childjobs}}
                <tr>
                    <td colspan="4" class="text-muted">{{#str}} bulknochildjobs, block_courseimport {{/str}}</td>
                </tr>
                {{/childjobs}}
            </tbody>
        </table>
    </div>
    {{{childpaginationbottom}}}
</div>

{{#isrunning}}
{{#js}}
require(['block_courseimport/bulk_status_progress'], function(mod) {
    mod.init({{bulkid}});
});
{{/js}}
{{/isrunning}}
