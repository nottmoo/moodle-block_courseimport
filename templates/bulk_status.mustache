{{!
    @template block_courseimport/bulk_status

    Single bulk job: summary + progress + child import jobs.
    Matches the visual style of import_status / core/async_backup_progress.
    Polls every 5 s while the job is still queued or running.
}}
<div class="block-courseimport-bulk-status container-fluid">
    <h2>{{heading}}</h2>

    {{#isrunning}}
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title mb-3">{{#str}} inprogress, block_courseimport {{/str}}</h5>

            <div class="progress mb-2 block-courseimport-progress">
                <div class="progress-bar progress-bar-striped progress-bar-animated bg-success block-courseimport-progress-bar"
                     role="progressbar"
                     style="width: {{progresspct}}%;"
                     aria-valuenow="{{progresspct}}"
                     aria-valuemin="0"
                     aria-valuemax="100">
                    {{progresspct}}%
                </div>
            </div>

            <div class="d-flex justify-content-between align-items-center mt-2">
                <small class="text-muted">
                    {{#str}} bulkstatuscompleted, block_courseimport {{/str}}: <strong>{{completed}}</strong>
                    &nbsp;/&nbsp;
                    {{#str}} bulkstatustotal, block_courseimport {{/str}}: <strong>{{total}}</strong>
                    {{#failed}}&nbsp;·&nbsp; {{#str}} bulkstatusfailed, block_courseimport {{/str}}: <strong class="text-danger">{{failed}}</strong>{{/failed}}
                </small>
                <small class="text-muted">{{#str}} bulkstatusrefreshing, block_courseimport {{/str}}</small>
            </div>
        </div>
    </div>
    {{/isrunning}}

    {{^isrunning}}
    <div class="alert {{#hasfailed}}alert-warning{{/hasfailed}}{{^hasfailed}}alert-success{{/hasfailed}} mb-4" role="alert">
        <strong>{{#str}} bulkstatusstate, block_courseimport {{/str}}:</strong> {{status}}
        &nbsp;·&nbsp; {{#str}} bulkstatuscompleted, block_courseimport {{/str}}: {{completed}}
        &nbsp;·&nbsp; {{#str}} bulkstatustotal, block_courseimport {{/str}}: {{total}}
        {{#failed}} &nbsp;·&nbsp; {{#str}} bulkstatusfailed, block_courseimport {{/str}}: {{failed}} {{/failed}}
    </div>
    {{/isrunning}}

    {{#showchildjobfilters}}
    <nav class="mb-3 block-courseimport-childjob-filters" aria-label="{{#str}} bulkchildjobfiltersnav, block_courseimport {{/str}}">
        <div class="d-flex flex-wrap align-items-baseline column-gap-3 row-gap-2">
            {{#childjobfilteritems}}
            <span>
                <a href="{{url}}"{{#current}} class="fw-bold text-decoration-underline" aria-current="page"{{/current}}>{{label}}</a> <span class="text-body-secondary">{{count}}</span>
            </span>
            {{/childjobfilteritems}}
        </div>
    </nav>
    {{/showchildjobfilters}}

    <h3>{{childheading}}</h3>
    {{{childpaginationtop}}}
    <div class="table-responsive">
        <table class="table table-striped table-sm">
            <thead>
                <tr>
                    <th>{{#str}} bulkstatusjobid, block_courseimport {{/str}}</th>
                    <th>{{#str}} bulkstatustarget, block_courseimport {{/str}}</th>
                    <th>{{#str}} bulkstatussource, block_courseimport {{/str}}</th>
                    <th>{{#str}} bulkstatusjobstate, block_courseimport {{/str}}</th>
                </tr>
            </thead>
            <tbody>
                {{#childjobs}}
                <tr>
                    <td>{{rownum}}</td>
                    <td>
                        {{#targetlinkurl}}
                        <a href="{{targetlinkurl}}" target="_blank" rel="noopener noreferrer">{{target}}</a> ({{targetid}})
                        {{/targetlinkurl}}
                        {{^targetlinkurl}}
                        {{target}} ({{targetid}})
                        {{/targetlinkurl}}
                    </td>
                    <td>{{source}} ({{sourceid}})</td>
                    <td>{{statelabel}}</td>
                </tr>
                {{/childjobs}}
                {{^childjobs}}
                <tr>
                    <td colspan="4" class="text-muted">{{#str}} bulknochildjobs, block_courseimport {{/str}}</td>
                </tr>
                {{/childjobs}}
            </tbody>
        </table>
    </div>
    {{{childpaginationbottom}}}
</div>

{{#isrunning}}
{{#js}}
(function() {
    setTimeout(function() {
        window.location.href = '{{refreshurl}}';
    }, 5000);
})();
{{/js}}
{{/isrunning}}
